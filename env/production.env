SECURE_COOKIE=false
JWT_SECRET=
COOKIE_SECRET=
# expires in 3 days
COOKIE_EXP=259200000

## Database ##
USER_NAME=
PASSWORD=
DBSERVER=localhost:5432
DATABASE=

